{
 "note": "Server refusals and what the app must do with them. Messages were captured from the real schema (supabase/migrations) on PostgreSQL 16 as the signed-in user. Expected results are written by hand.",
 "retryDelays": [5, 15, 60, 300, 900],
 "cases": [
  { "name": "no connection", "error": { "network": true }, "attempt": 1, "expect": { "action": "retry", "code": "offline", "delaySeconds": 5 } },
  { "name": "no connection, 3rd try", "error": { "network": true }, "attempt": 3, "expect": { "action": "retry", "code": "offline", "delaySeconds": 60 } },
  { "name": "no connection, 20th try stays at 15 minutes", "error": { "network": true }, "attempt": 20, "expect": { "action": "retry", "code": "offline", "delaySeconds": 900 } },
  { "name": "server waking up (free project paused)", "error": { "status": 503, "message": "Service Unavailable" }, "attempt": 2, "expect": { "action": "retry", "code": "server_busy", "delaySeconds": 15 } },
  { "name": "too many requests", "error": { "status": 429 }, "attempt": 1, "expect": { "action": "retry", "code": "server_busy", "delaySeconds": 5 } },
  { "name": "deadlock", "error": { "status": 500, "code": "40P01", "message": "deadlock detected" }, "attempt": 1, "expect": { "action": "retry", "code": "server_busy", "delaySeconds": 5 } },
  { "name": "sign-in expired", "error": { "status": 401, "code": "PGRST301", "message": "JWT expired" }, "attempt": 1, "expect": { "action": "sign_in", "code": "sign_in" } },
  { "name": "same work order number typed on both devices", "error": { "status": 409, "code": "23505", "message": "duplicate key value violates unique constraint \"work_orders_number_uq\"", "details": null },
    "row": { "wo_number": "441700101" }, "attempt": 1, "expect": { "action": "decision", "code": "duplicate_wo", "value": "441700101" } },
  { "name": "same tasreeh number on two orders", "error": { "status": 409, "code": "23505", "message": "duplicate key value violates unique constraint \"permits_number_uq\"" },
    "row": { "permit_number": " P-1 " }, "attempt": 1, "expect": { "action": "decision", "code": "duplicate_permit", "value": "P-1" } },
  { "name": "contractor added on both devices", "error": { "status": 409, "code": "23505", "message": "duplicate key value violates unique constraint \"contractors_name_uq\"" },
    "row": { "name": "al noor " }, "attempt": 1, "expect": { "action": "decision", "code": "duplicate_name", "value": "al noor" } },
  { "name": "duplicate value taken from the error when it is shown", "error": { "status": 409, "code": "23505", "message": "duplicate key value violates unique constraint \"work_orders_number_uq\"", "details": "Key (owner_id, wo_number)=(11111111-1111-1111-1111-111111111111, 441700555) already exists." },
    "attempt": 1, "expect": { "action": "decision", "code": "duplicate_wo", "value": "441700555" } },
  { "name": "other duplicate row", "error": { "status": 409, "code": "23505", "message": "duplicate key value violates unique constraint \"meters_seq_uq\"" }, "attempt": 1, "expect": { "action": "decision", "code": "duplicate_row" } },
  { "name": "a rule in the database", "error": { "status": 400, "code": "23514", "message": "new row for relation \"work_orders\" violates check constraint \"wo_excavation_switch\"" }, "attempt": 1,
    "expect": { "action": "decision", "code": "invalid_value", "constraint": "wo_excavation_switch" } },
  { "name": "date in the future (device clock wrong)", "error": { "status": 400, "code": "23514", "message": "The received date cannot be in the future." }, "attempt": 1, "expect": { "action": "decision", "code": "future_date" } },
  { "name": "order not uploaded yet: retried", "error": { "status": 403, "code": "42501", "message": "new row violates row-level security policy for table \"permits\"" }, "attempt": 4,
    "expect": { "action": "retry", "code": "parent_not_synced", "delaySeconds": 300 } },
  { "name": "order still missing after 5 tries", "error": { "status": 403, "code": "42501", "message": "new row violates row-level security policy for table \"permits\"" }, "attempt": 5, "expect": { "action": "decision", "code": "missing_parent" } },
  { "name": "foreign key missing, first try", "error": { "status": 409, "code": "23503", "message": "insert or update on table \"steps\" violates foreign key constraint" }, "attempt": 1, "expect": { "action": "retry", "code": "parent_not_synced", "delaySeconds": 5 } },
  { "name": "permanent delete refused", "error": { "status": 403, "code": "42501", "message": "permission denied for table work_orders" }, "attempt": 1, "expect": { "action": "decision", "code": "not_allowed" } },
  { "name": "bad date value", "error": { "status": 400, "code": "22008", "message": "date/time field value out of range: \"2026-13-01\"" }, "attempt": 1, "expect": { "action": "decision", "code": "invalid_value", "constraint": null } },
  { "name": "required field empty", "error": { "status": 400, "code": "23502", "message": "null value in column \"received_date\" of relation \"work_orders\" violates not-null constraint" }, "attempt": 1,
    "expect": { "action": "decision", "code": "invalid_value", "constraint": null } },
  { "name": "unknown refusal", "error": { "status": 400, "code": "PGRST204", "message": "Could not find the 'colour' column of 'work_orders' in the schema cache" }, "attempt": 1,
    "expect": { "action": "decision", "code": "refused_other", "message": "Could not find the 'colour' column of 'work_orders' in the schema cache" } }
 ]
}
